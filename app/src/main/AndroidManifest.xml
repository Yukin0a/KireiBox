<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.xiaoji.egggame" />
        <!-- Winlator-CN: by package, and by its launch link so a repackaged build is found too. -->
        <package android:name="com.winlator" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="winlator" android:host="launch" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".YukiHubApp"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:requestLegacyExternalStorage="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <activity android:name="com.kireibox.auth.CoverLoginActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode" />

        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name="com.kireibox.app.LauncherActivity"
            android:exported="true"
            android:resizeableActivity="true"
            android:maxAspectRatio="2.4"
            android:theme="@style/Theme.YukiHub.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="org.tvp.kirikiri2.KR2Activity"
            android:exported="false"
            android:process=":kirikiri2"
            android:launchMode="singleInstance"
            android:taskAffinity="com.yuki.yukihub.Kirikiroid2"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="true"
            android:theme="@style/Theme.YukiHub.Kirikiroid2"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode|density" />

        <activity
            android:name="com.akira.tyranoemu.remote.Kirikiroid139"
            android:exported="false"
            android:process=":kirikiri2"
            android:launchMode="singleInstance"
            android:taskAffinity="com.yuki.yukihub.Kirikiroid2"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="true"
            android:theme="@style/Theme.YukiHub.Kirikiroid2"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode|density" />

        <activity
            android:name="com.akira.tyranoemu.remote.Kirikiroid134"
            android:exported="false"
            android:process=":kirikiri2"
            android:launchMode="singleInstance"
            android:taskAffinity="com.yuki.yukihub.Kirikiroid2"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="true"
            android:theme="@style/Theme.YukiHub.Kirikiroid2Compatible"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode|density" />

        <activity
            android:name="com.akira.tyranoemu.remote.Kirikiroid126"
            android:exported="false"
            android:process=":kirikiri2"
            android:launchMode="singleInstance"
            android:taskAffinity="com.yuki.yukihub.Kirikiroid2"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="true"
            android:theme="@style/Theme.YukiHub.Kirikiroid2Compatible"
            android:windowSoftInputMode="adjustPan"
            android:configChanges="keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode|density" />

        <activity
            android:name="com.yuki.yukihub.tyrano.TyranoActivity"
            android:exported="false"
            android:process=":tyrano"
            android:launchMode="singleInstance"
            android:taskAffinity="com.yuki.yukihub.Tyrano"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboardHidden|screenSize" />

        <activity
            android:name="com.akira.tyranoemu.remote.ArtemisActivityV1"
            android:exported="false"
            android:process=":artemis"
            android:launchMode="singleInstance"
            android:taskAffinity="com.yuki.yukihub.Artemis"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboardHidden|screenSize">
            <meta-data android:name="android.app.lib_name" android:value="artemis" />
        </activity>

        <activity
            android:name="com.akira.tyranoemu.remote.ArtemisActivityV2"
            android:exported="false"
            android:process=":artemis"
            android:launchMode="singleInstance"
            android:taskAffinity="com.yuki.yukihub.Artemis"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboardHidden|screenSize">
            <meta-data android:name="android.app.lib_name" android:value="artemis-compatible" />
        </activity>

        <activity
            android:name="com.akira.tyranoemu.remote.ArtemisActivityV3"
            android:exported="false"
            android:process=":artemis"
            android:launchMode="singleInstance"
            android:taskAffinity="com.yuki.yukihub.Artemis"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboardHidden|screenSize">
            <meta-data android:name="android.app.lib_name" android:value="artemis-compatible-v2" />
        </activity>

        <activity
            android:name="com.ies_net.artemis.VideoViewActivity"
            android:exported="false"
            android:process=":artemis"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboardHidden|screenSize" />

        <activity
            android:name="com.yuri.onscripter.ONScripter"
            android:exported="false"
            android:process=":ons"
            android:launchMode="singleInstance"
            android:taskAffinity="com.yuki.yukihub.ONScripter"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboardHidden|screenSize|screenLayout|smallestScreenSize|uiMode" />

        <activity
            android:name="com.yuki.yukihub.ons.OnsVideoActivity"
            android:exported="false"
            android:process=":ons"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboardHidden|screenSize" />

    </application>
</manifest>
