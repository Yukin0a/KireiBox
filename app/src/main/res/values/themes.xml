<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:colorAccent">@color/yh_primary</item>
        <item name="colorPrimary">@color/yh_primary</item>
        <item name="colorPrimaryDark">@color/yh_bg_2</item>
    </style>

    <style name="AppTheme" parent="Base.AppTheme" />

    <style name="Theme.YukiHub.Kirikiroid2" parent="android:style/Theme.Material.NoActionBar.Fullscreen">
<item name="android:backgroundDimAmount">1.0</item>
<item name="android:backgroundDimEnabled">true</item>
<item name="android:windowNoTitle">true</item>
<item name="android:windowActionBar">false</item>
<item name="android:windowFullscreen">true</item>
<item name="android:windowBackground">@color/launcher_bg_color</item>
<item name="android:windowDisablePreview">false</item>
</style>

<style name="Theme.YukiHub.Kirikiroid2Compatible" parent="android:style/Theme.Material.NoActionBar.Fullscreen">
<item name="android:windowNoTitle">true</item>
<item name="android:windowActionBar">false</item>
<item name="android:windowFullscreen">true</item>
<item name="android:windowBackground">@color/launcher_bg_color</item>
<item name="android:windowDisablePreview">false</item>
</style>

<!-- Shared view styles are defined in values/styles.xml. -->
</resources>
